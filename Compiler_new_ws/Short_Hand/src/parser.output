Terminals unused in grammar

    ETOK
    WHILE


Grammar

    0 $accept: PROGRAMME_RULE $end

    1 PROGRAMME_RULE: MODULE_PREAMBLE_RULE DECLARATION_STATEMENT_LIST_RULE FUNCTION_LIST_RULE LOGIC_BLOCK

    2 MODULE_PREAMBLE_RULE: ε
    3                     | MODULE_PREAMBLE_RULE PACKAGE_DECLARATION
    4                     | MODULE_PREAMBLE_RULE MODULE_DECLARATION
    5                     | MODULE_PREAMBLE_RULE IMPORT_DECLARATION

    6 PACKAGE_DECLARATION: PACKAGE MODULE_PATH ';'

    7 MODULE_DECLARATION: MODULE MODULE_PATH ';'

    8 IMPORT_DECLARATION: IMPORT MODULE_PATH IMPORT_ALIAS_OPT ';'

    9 MODULE_PATH: IDENTIFIER
   10            | MODULE_PATH '.' IDENTIFIER

   11 IMPORT_ALIAS_OPT: ε
   12                 | AS IDENTIFIER

   13 FUNCTION_LIST_RULE: FUNCTION_LIST_RULE FUNCTION_RULE ';'
   14                   | ε

   15 FUNCTION_RULE: DEF ShortType IDENTIFIER '(' FUNCTION_PARAMETER_LIST_RULE ')' STATEMENT_BLOCK_RULE

   16 FUNCTION_PARAMETER_LIST_RULE: DECLARATION_STATEMENT_LIST_RULE
   17                             | ε

   18 DECLARATION_STATEMENT_LIST_RULE: DECLARATION_STATEMENT_LIST_RULE DECLARATION_STATEMENT_RULE ';'
   19                                | DECLARATION_STATEMENT_RULE ';'

   20 ShortType: INT
   21          | FLOAT
   22          | DOUBLE
   23          | STRING
   24          | VOID
   25          | BOOL

   26 DECLARATION_STATEMENT_RULE: ShortType DECLARATION_VARIABLE_LIST_RULE

   27 DECLARATION_VARIABLE_LIST_RULE: DECLARATION_VARIABLE_LIST_RULE ',' IDENTIFIER
   28                               | DECLARATION_VARIABLE_LIST_RULE ',' IDENTIFIER '[' INT_LITERAL ']'
   29                               | IDENTIFIER
   30                               | IDENTIFIER '[' INT_LITERAL ']'
   31                               | ε

   32 LOGIC_BLOCK: TOP_LEVEL_STATEMENT_LIST_RULE

   33 TOP_LEVEL_STATEMENT_LIST_RULE: TOP_LEVEL_STATEMENT_LIST_RULE EXECUTABLE_STATEMENT_RULE
   34                              | EXECUTABLE_STATEMENT_RULE

   35 STATEMENT_BLOCK_RULE: '{' STATEMENT_LIST_RULE '}'

   36 STATEMENT_LIST_RULE: STATEMENT_LIST_RULE STATEMENT_RULE
   37                    | STATEMENT_RULE

   38 STATEMENT_RULE: EXECUTABLE_STATEMENT_RULE
   39               | DECLARATION_STATEMENT_RULE ';'

   40 EXECUTABLE_STATEMENT_RULE: MODEL_DECLARATION
   41                          | TENSOR_DECLARATION
   42                          | GREENAI_CONTRACT
   43                          | GREENAI_MEASUREMENT
   44                          | C3ECO_DECLARATION
   45                          | INFER_STATEMENT
   46                          | RETURN_STATEMENT
   47                          | CONTINUE ';'
   48                          | EXPRESSION_RULE ';'
   49                          | VARIABLE_RULE '=' EXPRESSION_RULE ';'
   50                          | STATEMENT_BLOCK_RULE
   51                          | IF EXPRESSION_RULE STATEMENT_BLOCK_RULE
   52                          | IF EXPRESSION_RULE STATEMENT_BLOCK_RULE ELSE STATEMENT_BLOCK_RULE
   53                          | LOOP VARIABLE_RULE '=' EXPRESSION_RULE ',' EXPRESSION_RULE STATEMENT_BLOCK_RULE
   54                          | LOOP VARIABLE_RULE '=' EXPRESSION_RULE ',' EXPRESSION_RULE ',' EXPRESSION_RULE STATEMENT_BLOCK_RULE
   55                          | LOOP EXPRESSION_RULE STATEMENT_BLOCK_RULE
   56                          | GOTO IDENTIFIER ';'
   57                          | GOTO IDENTIFIER IF EXPRESSION_RULE ';'
   58                          | READ READ_VARIABLE_LIST_RULE ';'
   59                          | BREAK ';'
   60                          | PRINT PRINT_VARIABLE_LIST_RULE ';'
   61                          | GREENAI_REPORT_RULE ';'
   62                          | AI_INFER_RULE ';'
   63                          | IDENTIFIER ':'
   64                          | ';'

   65 RETURN_STATEMENT: RETURN EXPRESSION_RULE ';'
   66                 | RETURN ';'

   67 INFER_STATEMENT: INFER IDENTIFIER '(' IDENTIFIER ')' ARROW IDENTIFIER ';'
   68                | INFER IDENTIFIER '(' IDENTIFIER ')' GREATER IDENTIFIER ';'

   69 TENSOR_DECLARATION: TENSOR IDENTIFIER PRECISION_NAME STRING_LITERAL ';'

   70 $@1: ε

   71 MODEL_DECLARATION: MODEL IDENTIFIER '{' $@1 MODEL_FIELD_LIST '}' ';'

   72 MODEL_FIELD_LIST: MODEL_FIELD_LIST MODEL_FIELD
   73                 | ε

   74 MODEL_FIELD: FORMAT FORMAT_NAME ';'
   75            | PATH STRING_LITERAL ';'
   76            | TASK STRING_LITERAL ';'
   77            | PRECISION PRECISION_NAME ';'
   78            | INPUT_SHAPE STRING_LITERAL ';'
   79            | OUTPUT_SHAPE STRING_LITERAL ';'
   80            | BACKEND_PREFERENCE BACKEND_LIST ';'
   81            | COMPACT TRUE ';'
   82            | COMPACT FALSE ';'
   83            | QUALITY_GUARDRAIL IDENTIFIER GREATER_OR_EQUAL INT_LITERAL ';'

   84 BACKEND_LIST: BACKEND_LIST ',' BACKEND_NAME
   85             | BACKEND_NAME

   86 $@2: ε

   87 GREENAI_CONTRACT: GREENAI_CONTRACT_T IDENTIFIER '{' $@2 CONTRACT_FIELD_LIST '}' ';'

   88 CONTRACT_FIELD_LIST: CONTRACT_FIELD_LIST CONTRACT_FIELD
   89                    | ε

   90 CONTRACT_FIELD: FUNCTIONAL_UNIT STRING_LITERAL ';'
   91               | SUCCESS_CRITERIA STRING_LITERAL ';'
   92               | BOUNDARY BOUNDARY_LIST ';'
   93               | MEASUREMENT_QUALITY MQ_NAME ';'
   94               | DATA_QUALITY DQ_NAME ';'
   95               | CARBON_FACTOR LOCATION INT_LITERAL ';'
   96               | ENERGY_BUDGET_J INT_LITERAL ';'
   97               | CARBON_BUDGET_GCO2E INT_LITERAL ';'
   98               | QUALITY_GUARDRAIL IDENTIFIER GREATER_OR_EQUAL INT_LITERAL ';'
   99               | EVIDENCE_RETENTION STRING_LITERAL ';'
  100               | CLAIMS_MODE EVIDENCE_ONLY ';'

  101 BOUNDARY_LIST: BOUNDARY_LIST ',' BOUNDARY_NAME
  102              | BOUNDARY_NAME

  103 $@3: ε

  104 GREENAI_MEASUREMENT: GREENAI_MEASURE IDENTIFIER '{' $@3 MEASURE_FIELD_LIST '}' ';'

  105 MEASURE_FIELD_LIST: MEASURE_FIELD_LIST MEASURE_FIELD
  106                   | ε

  107 MEASURE_FIELD: IDENTIFIER INT_LITERAL ';'
  108              | IDENTIFIER IDENTIFIER ';'

  109 $@4: ε

  110 C3ECO_DECLARATION: CERTIFICATION_PROFILE IDENTIFIER '{' $@4 C3ECO_FIELD_LIST '}' ';'

  111 $@5: ε

  112 C3ECO_DECLARATION: CERTIFICATION IDENTIFIER '{' $@5 C3ECO_FIELD_LIST '}' ';'

  113 $@6: ε

  114 C3ECO_DECLARATION: FUNCTIONAL_UNIT IDENTIFIER '{' $@6 C3ECO_FIELD_LIST '}' ';'

  115 $@7: ε

  116 C3ECO_DECLARATION: WORKLOAD IDENTIFIER '{' $@7 C3ECO_FIELD_LIST '}' ';'

  117 $@8: ε

  118 C3ECO_DECLARATION: BOUNDARY IDENTIFIER '{' $@8 C3ECO_FIELD_LIST '}' ';'

  119 $@9: ε

  120 C3ECO_DECLARATION: MEASUREMENT_PLAN IDENTIFIER '{' $@9 C3ECO_FIELD_LIST '}' ';'

  121 $@10: ε

  122 C3ECO_DECLARATION: AI_LIFECYCLE IDENTIFIER '{' $@10 C3ECO_FIELD_LIST '}' ';'

  123 $@11: ε

  124 C3ECO_DECLARATION: RAG_PIPELINE IDENTIFIER '{' $@11 C3ECO_FIELD_LIST '}' ';'

  125 $@12: ε

  126 C3ECO_DECLARATION: TOKEN_BUDGET IDENTIFIER '{' $@12 C3ECO_FIELD_LIST '}' ';'

  127 $@13: ε

  128 C3ECO_DECLARATION: MODEL_ROUTING IDENTIFIER '{' $@13 C3ECO_FIELD_LIST '}' ';'

  129 $@14: ε

  130 C3ECO_DECLARATION: GUARDRAILS IDENTIFIER '{' $@14 C3ECO_FIELD_LIST '}' ';'

  131 C3ECO_FIELD_LIST: C3ECO_FIELD_LIST C3ECO_FIELD
  132                 | ε

  133 C3ECO_FIELD: C3ECO_FIELD_NAME STRING_LITERAL ';'
  134            | C3ECO_FIELD_NAME C3ECO_IDENTIFIER_VALUE ';'
  135            | C3ECO_FIELD_NAME INT_LITERAL ';'
  136            | C3ECO_FIELD_NAME FLOAT_LITERAL ';'
  137            | C3ECO_FIELD_NAME TRUE ';'
  138            | C3ECO_FIELD_NAME FALSE ';'

  139 C3ECO_FIELD_NAME: IDENTIFIER
  140                 | CARBON_FACTOR
  141                 | FALLBACK
  142                 | QUALITY_GUARDRAIL
  143                 | FUNCTIONAL_UNIT
  144                 | BOUNDARY

  145 C3ECO_IDENTIFIER_VALUE: IDENTIFIER
  146                       | BOUNDARY_NAME
  147                       | MQ_NAME
  148                       | DQ_NAME
  149                       | LOCATION
  150                       | EVIDENCE_ONLY
  151                       | FALLBACK

  152 FORMAT_NAME: ONNX
  153            | ENGINE
  154            | TORCHSCRIPT
  155            | OPENVINO_IR
  156            | GGUF

  157 PRECISION_NAME: INT8
  158               | INT4
  159               | FP16
  160               | FP32
  161               | BF16
  162               | FP64
  163               | FLOAT

  164 BACKEND_NAME: TENSORRT
  165             | ONNXRUNTIME_TENSORRT
  166             | ONNXRUNTIME_CUDA
  167             | ONNXRUNTIME_CPU
  168             | OPENVINO
  169             | LIBTORCH
  170             | LLAMACPP
  171             | FALLBACK

  172 MQ_NAME: MQ1
  173        | MQ2
  174        | MQ3
  175        | MQ4

  176 DQ_NAME: DQ1
  177        | DQ2
  178        | DQ3
  179        | DQ4

  180 BOUNDARY_NAME: COMPUTE
  181              | ACCELERATOR
  182              | STORAGE
  183              | NETWORK
  184              | CI_CD
  185              | THIRDPARTY

  186 AI_INFER_RULE: AI_INFER_BUILTIN '(' STRING_LITERAL ',' STRING_LITERAL ',' STRING_LITERAL ')'

  187 GREENAI_REPORT_RULE: GREENAI_REPORT_BUILTIN '(' STRING_LITERAL ',' EXPRESSION_RULE ',' EXPRESSION_RULE ',' EXPRESSION_RULE ')'

  188 EXPRESSION_RULE: EXPRESSION_RULE '+' EXPRESSION_RULE
  189                | EXPRESSION_RULE '-' EXPRESSION_RULE
  190                | EXPRESSION_RULE '*' EXPRESSION_RULE
  191                | EXPRESSION_RULE '/' EXPRESSION_RULE
  192                | EXPRESSION_RULE '%' EXPRESSION_RULE
  193                | EXPRESSION_RULE LESS EXPRESSION_RULE
  194                | EXPRESSION_RULE LESS_OR_EQUAL EXPRESSION_RULE
  195                | EXPRESSION_RULE GREATER EXPRESSION_RULE
  196                | EXPRESSION_RULE GREATER_OR_EQUAL EXPRESSION_RULE
  197                | EXPRESSION_RULE EQUAL EXPRESSION_RULE
  198                | EXPRESSION_RULE NOT_EQUAL EXPRESSION_RULE
  199                | EXPRESSION_RULE OR EXPRESSION_RULE
  200                | EXPRESSION_RULE AND EXPRESSION_RULE
  201                | '-' EXPRESSION_RULE
  202                | '(' EXPRESSION_RULE ')'
  203                | IDENTIFIER '(' EXPRESSION_LIST_OPT ')'
  204                | VARIABLE_RULE
  205                | INT_LITERAL
  206                | FLOAT_LITERAL
  207                | STRING_LITERAL
  208                | TRUE
  209                | FALSE

  210 EXPRESSION_LIST_OPT: EXPRESSION_LIST_RULE
  211                    | ε

  212 EXPRESSION_LIST_RULE: EXPRESSION_LIST_RULE ',' EXPRESSION_RULE
  213                     | EXPRESSION_RULE

  214 VARIABLE_RULE: IDENTIFIER
  215              | IDENTIFIER '[' EXPRESSION_RULE ']'

  216 READ_VARIABLE_LIST_RULE: READ_VARIABLE_LIST_RULE ',' VARIABLE_RULE
  217                        | VARIABLE_RULE

  218 PRINT_VARIABLE_LIST_RULE: PRINT_VARIABLE_LIST_RULE ',' EXPRESSION_RULE
  219                         | EXPRESSION_RULE


