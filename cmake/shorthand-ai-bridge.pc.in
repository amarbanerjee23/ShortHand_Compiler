prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ShortHand AI Bridge
Description: ShortHand C++ AI runtime bridge adapter
Version: @SHORTHAND_RUNTIME_API_VERSION@
Libs: -L${libdir} -lshorthand_ai_bridge
Cflags: -I${includedir}/shorthand
