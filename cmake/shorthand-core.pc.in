prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ShortHand Core
Description: Versioned ShortHand core library and safe C ABI
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lshorthand_core
Cflags: -I${includedir}
