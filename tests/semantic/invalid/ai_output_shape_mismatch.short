tensor input float "1,3,224,224";
tensor output float "1,10";
model classifier {
  format onnx;
  path "models/classifier.onnx";
  task "image_classification";
  precision float32;
  input_shape "1,3,224,224";
  output_shape "1,1000";
  backend_preference onnxruntime_cpu, fallback;
  compact true;
  quality_guardrail accuracy >= 90;
};
infer classifier(input) -> output;
