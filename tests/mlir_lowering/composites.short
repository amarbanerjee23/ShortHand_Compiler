language shorthand.enterprise_language.v2;
namespace policyclub.sustainable_ai;
record Evidence { float64 energy_j; bool quality_passed; string id; };
enum State { success; failed; };
option MaybeScore<float64>;
result Prediction<float64,string>;
slice Scores<float64>;
owned Evidence pending = Evidence(12.5, true, "inference #42 // measured");
borrow shared pending as audit;
print audit.energy_j, audit.quality_passed, audit.id;
release audit;
move pending to verified;
borrow mutable verified as writer;
set writer.energy_j = 10.25;
release writer;
print verified.energy_j;
owned State status = State.success;
print status.tag;
owned MaybeScore score = MaybeScore.some(0.95);
print score.tag, score.value;
owned MaybeScore missing = MaybeScore.none;
print missing.tag;
owned Prediction prediction = Prediction.ok(42.0);
print prediction.tag, prediction.ok;
owned Prediction failure = Prediction.error("backend unavailable");
print failure.tag, failure.error;
array float64 inputs[4] = [2.0, 4.0, 6.0, 8.0];
view Scores selected = inputs[1, 2];
print selected[0], selected[1];
release selected;
set inputs[1] = 5.0;
print inputs[1];
