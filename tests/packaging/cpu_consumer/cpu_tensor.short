int status;
tensor input float "1" = [42.5];
tensor output float "1";
model identity {
  format onnx;
  path "identity.onnx";
  task "identity";
  precision float;
  input_shape "1";
  output_shape "1";
  backend_preference onnxruntime_cpu;
  compact false;
  quality_guardrail accuracy >= 1;
};
infer identity(input) -> output;
output[0] = output[0] + 1.0;
infer identity(output) -> input;
print "Installed tensor values", output[0], input[0];
print "Installed typed inference completed";
