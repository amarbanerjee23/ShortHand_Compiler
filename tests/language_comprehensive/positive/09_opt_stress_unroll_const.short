float w[12], acc, best_val, d1, d2;
int i, cls, best_cls;
w[0] = 0.5; w[1] = -1.25; w[2] = 2.0; w[3] = 0.75;
w[4] = 1.5; w[5] = 0.25; w[6] = -0.5; w[7] = 1.0;
w[8] = -0.25; w[9] = 2.5; w[10] = 0.5; w[11] = -1.5;
best_val = -1000.0;
best_cls = -1;
loop cls = 0, 1, 3 {
    acc = 0.0;
    loop i = 0, 1, 4 {
        acc = acc + w[cls * 4 + i] * 0.5;
    }
    if acc > best_val {
        best_val = acc;
        best_cls = cls;
    }
}
d1 = best_val / 2.0;
d2 = best_val / 3.0;
print best_cls, best_val, d1, d2;
