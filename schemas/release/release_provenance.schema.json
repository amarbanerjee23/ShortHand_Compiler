{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/amarbanerjee23/ShortHand_Compiler/schemas/release/release_provenance.schema.json",
  "title": "ShortHand candidate release provenance",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "commit",
    "generated_at",
    "tracked_file_count",
    "source_hash_manifest",
    "sbom",
    "release_status",
    "attestation_status",
    "certification_status"
  ],
  "properties": {
    "schema_version": { "const": "shorthand.release.provenance.v1" },
    "repository": { "type": "string" },
    "commit": { "type": "string" },
    "generated_at": { "type": "string" },
    "tracked_file_count": { "type": "integer", "minimum": 1 },
    "source_hash_manifest": { "type": "string" },
    "sbom": { "type": "string" },
    "release_status": { "const": "candidate_evidence_only" },
    "attestation_status": { "enum": ["unsigned_local_candidate", "signed_release_artifact"] },
    "certification_status": { "type": "string" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
