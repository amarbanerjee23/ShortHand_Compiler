{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortHand pilot run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "organization",
    "executed_on",
    "environment_sha256",
    "environment_ref",
    "result_sha256",
    "result_ref",
    "revision",
    "completed_units"
  ],
  "properties": {
    "schema": {
      "const": "shorthand.c3eco.pilot_run.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "executed_on": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "completed_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    }
  }
}
