{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShortHand pilot operations v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "custodian",
    "observed_on",
    "retain_until",
    "immutable_storage_enabled",
    "encryption_enabled",
    "access_review_passed",
    "next_surveillance_on",
    "open_major_findings",
    "unreviewed_changes",
    "storage_evidence_ref",
    "access_evidence_ref",
    "surveillance_evidence_ref",
    "independence_evidence_ref",
    "draft_review_ref",
    "restore_source_ref",
    "restore_result_ref"
  ],
  "properties": {
    "schema": {
      "const": "shorthand.c3eco.pilot_operations.v1"
    },
    "custodian": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "observed_on": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "retain_until": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "immutable_storage_enabled": {
      "type": "boolean"
    },
    "encryption_enabled": {
      "type": "boolean"
    },
    "access_review_passed": {
      "type": "boolean"
    },
    "next_surveillance_on": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "open_major_findings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "unreviewed_changes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "storage_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "access_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "surveillance_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "independence_evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "draft_review_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "restore_source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "restore_result_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
